@model Produto

	@using FrangoZe.Web.Models.Model;

@{
	ViewData["Title"] = "Confirmação apagar a produto";
}

<html>
<body>
	<div class="align-items-center">
		<div class=" text-center">
			<h3>Deseja realmente excluir o produto "@Model.Nome" ?</h3>
		</div>
		<div class=" d-grid gap-2">
			<a class=" btn btn-primary" role="button" asp-controller="Produto" asp-route-id="@Model.Id" asp-action="ApagarConfirmado">Confirmar</a>
			<a class=" btn btn-secondary" role="button" asp-controller="Produto" asp-action="Index">Cancelar</a>
		</div>
	</div>
</body>
</html>
