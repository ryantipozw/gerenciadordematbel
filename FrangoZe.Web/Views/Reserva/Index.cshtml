@model ReservaProdutoViewModel

@{
	ViewData["Title"] = "Lista de Reservas";
}
@using FrangoZe.Web.Models.Model;
@using FrangoZe.Web.Models;
@using FrangoZe.Web.ViewModels;


<html>
<body class="text-center">
	<div class="text-left">
		<h1 class="display-4">Reservas e Vendas</h1>
		<hr />
	</div>
	<div class="d-grid gap-2 d-md-flex justify-content-md-center">
		<a class="btn btn-primary" role="button" asp-controller="Reserva" asp-action="Criar">Nova reserva</a>
	</div>
	<div>
		<table class="table">
			<thead>
				<tr>
					<th scope="col">Id</th>
					<th scope="col">Nome</th>
					<th scope="col">Itens</th>
					<th scope="col">Total</th>
					<th scope="col">Horário da reserva</th>
					<th scope="col">Horário da entrega</th>
					<th scope="col">Endereço</th>
					<th scope="col">Pagamento</th>
					<th scope="col"></th>
				</tr>
			</thead>
			<tbody>
				@if (Model.reservas != null && Model.reservas.Any())
				{
					foreach (var reserva in Model.reservas)
					{
						<tr>
							<th scope="row">@reserva.Id</th>
							<td>@reserva.Cliente_Nome</td>
							<td><pre>@reserva.MostrarProdutosEscolhidos()</pre></td>
							<td>R$@reserva.MostrarTotal()<br/></td>
							<td>@reserva.Hora_Reserva</td>
							<td>@reserva.MostrarHREntrega()</td>
							<td>@reserva.MostrarEndereco()</td>
							<td>@reserva.MostrarPagamento()</td>
							<td>
								<div class="btn-group" role="group">
									<a role="button" class="btn btn-primary" asp-route-id="@reserva.Id" asp-controller="Reserva" asp-action="Editar">Editar</a>
									<a role="button" class="btn btn-danger" asp-route-id="@reserva.Id" asp-controller="Reserva" asp-action="Apagar">Fechar/Cancelar</a>
								</div>
							</td>
						</tr>
					}
				}
			</tbody>
		</table>

	</div>
</body>
</html>